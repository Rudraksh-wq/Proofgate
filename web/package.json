{
  "name": "proofgate-site",
  "version": "0.1.0",
  "private": true,
  "description": "ProofGate marketing and install site. Static: no backend, no forms, no uploads, no analytics.",
  "scripts": {
    "prebuild": "node scripts/build-content.mjs",
    "dev": "next dev -p 3001",
    "build": "next build",
    "postbuild": "node scripts/set-site.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.12",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "typescript": "5.5.4"
  }
}
