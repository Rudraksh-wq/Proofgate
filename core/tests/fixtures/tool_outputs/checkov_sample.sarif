{
  "version": "2.1.0",
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "runs": [{
    "tool": {"driver": {"name": "Checkov", "version": "3.2.0"}},
    "results": [
      {"ruleId": "CKV_DOCKER_2", "level": "error", "message": {"text": "Ensure that HEALTHCHECK instructions have been added to container images"},
       "locations": [{"physicalLocation": {"artifactLocation": {"uri": "Dockerfile"}, "region": {"startLine": 1, "endLine": 12}}}]},
      {"ruleId": "CKV_AWS_20", "level": "warning", "message": {"text": "S3 Bucket has an ACL defined which allows public READ access."},
       "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/main.tf"}, "region": {"startLine": 4}}}]}
    ]
  }]
}
