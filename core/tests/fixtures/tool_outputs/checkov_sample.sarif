       "name": "S3 Bucket has an ACL defined which allows public READ access.",
       "shortDescription": {
        "text": "S3 Bucket has an ACL defined which allows public READ access."
       },
       "fullDescription": {
        "text": "S3 Bucket has an ACL defined which allows public READ access."
