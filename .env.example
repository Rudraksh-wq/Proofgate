# Names only. Put real values in .env, which is git-ignored. Never commit a value.
GEMINI_API_KEY=
GEMINI_MODEL=
PROOFGATE_OFFLINE=0
PROOFGATE_API_URL=http://localhost:8000
PROOFGATE_TOOLS_DIR=
PROOFGATE_GEMINI_PAID=0

# Supabase test project (hosted backend). Use a project that exists only for testing.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# direct or pooler connection string of the SAME project (used for migrations and Splinter)
SUPABASE_DB_URL=
# comma-separated project refs ProofGate may send test traffic to (the "xxxx" in https://xxxx.supabase.co). Anything else is refused.
PROOFGATE_ALLOWED_PROJECT_REFS=
# hosted | local | auto
PROOFGATE_SUPABASE_BACKEND=auto
